# Vite Environment Configuration Template
# Copy this file to '.env' or '.env.production' and update the values.

# The base API endpoint of the EvaOps DevOps Backend server
VITE_API_BASE=http://localhost:5005/api

# The default fallback DNS domain name for the organization SWA custom domains
VITE_DEFAULT_DOMAIN=example.com

# The default organization Azure DevOps URL (used to prepopulate input forms)
VITE_AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
